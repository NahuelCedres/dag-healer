# Settings of the dag-healer development stack (docker/compose.yaml).
#
# scripts/tasks.py copies this file to docker/.env when it is missing (docker/.env is never
# committed). Docker Compose reads docker/.env for variable interpolation; values exported
# in your shell take precedence.
#
# Every secret below is a fixed, publicly known DEVELOPMENT value. The stack is meant for a
# local machine only: generate your own values before sharing it with anyone.

# ---------------------------------------------------------------------------- containers
# UID that runs the Airflow containers (group is always 0). Keep 50000 on Docker Desktop
# (Windows/macOS). On Linux use your own id (`id -u`) so files under .demo/ stay yours;
# scripts/tasks.py fills it in when it creates docker/.env on Linux.
AIRFLOW_UID=50000

# The engine socket that docker/compose.yaml mounts into healer-worker, which starts a container
# for every pytest run of a repair (docker/README.md, "Test sandbox"). Rootless Docker or Podman:
# the user's socket, for example /run/user/1000/docker.sock or /run/user/1000/podman/podman.sock.
# HEALER_DOCKER_SOCKET=/var/run/docker.sock
# Group of that socket, which healer-worker joins. Linux: the docker group
# (`stat -c %g /var/run/docker.sock`); scripts/tasks.py fills it in when it creates docker/.env.
# Docker Desktop and OrbStack: keep 0.
HEALER_DOCKER_GID=0

# ---------------------------------------------------------------------------- Airflow secrets
# INSECURE development defaults. Generate real ones with:
#   python -c "import base64, os; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
FERNET_KEY=oBP-x0wLjzJcrv0PMy2BuNMcHMiohFuV5IJG82kmc9c=
AIRFLOW__API_AUTH__JWT_SECRET=dag-healer-dev-jwt-secret-insecure

# ---------------------------------------------------------------------------- dag-healer
# Shared secret between the Airflow listener/callback (task processes) and the ingest
# endpoint /healer/api/v1/events/task-failed. INSECURE development value.
HEALER_INGEST_TOKEN=dag-healer-dev-ingest-token

# Airflow account the healer worker uses for the REST API (created by airflow-init).
HEALER_AIRFLOW_USERNAME=admin
HEALER_AIRFLOW_PASSWORD=admin

# LLM provider of the healer worker. Without a value it is "fake": an offline provider that
# follows the policy hints and replays the scripts in <repo>/fixtures/fake_llm, so the demo
# runs without any API key. To use Claude (model: claude-opus-5-5) set BOTH lines below:
#   HEALER_LLM_PROVIDER=anthropic
#   ANTHROPIC_API_KEY=sk-ant-...
#
# To use Claude on Amazon Bedrock instead (docs/bedrock.md): change the HEALER_LLM_PROVIDER=
# line below to HEALER_LLM_PROVIDER=bedrock, leave ANTHROPIC_API_KEY empty, and uncomment the
# HEALER_LLM_MODEL and AWS_REGION lines under them, set to your Bedrock model or inference profile
# ID and your AWS region. The AWS credentials come from the shell that starts the stack, never
# from this file: export temporary ones first, for example with
#   eval "$(aws configure export-credentials --profile <profile> --format env)"
# (or a short-term Bedrock API key in AWS_BEARER_TOKEN_BEDROCK). Only healer-worker receives
# them. HEALER_LLM_MODEL needs a healer.yaml that reads it: `python scripts/tasks.py demo`
# writes a new one (docker/README.md, "LLM provider"). Keep unused AWS lines commented: an
# empty value reaches the worker as it is.
HEALER_LLM_PROVIDER=
ANTHROPIC_API_KEY=
# HEALER_LLM_MODEL=eu.anthropic.claude-opus-5-5
# AWS_REGION=eu-west-1

# Optional: open real GitHub pull requests for CODE fixes. GITHUB_REPO is the repository as
# "owner/name"; GITHUB_TOKEN is a fine-grained personal access token limited to that one
# repository ("Only select repositories"), with the repository permissions Contents and Pull
# requests set to "Read and write" (GitHub adds Metadata: read-only by itself) and no other
# permission, in particular no Workflows. Without them dag-healer writes PR.md + fix.patch
# under $HEALER_HOME/prs/<incident_id>/ and pushes a local branch instead.
# The fix's commit carries [skip ci] (github.skip_ci in healer.yaml, default true), so the
# repository's CI runs on the healer branch only once a person starts it after the review.
# docs/github/README.md sets up the token, the base branch's rules and CI;
# `python scripts/tasks.py doctor` checks them.
GITHUB_TOKEN=
GITHUB_REPO=

# ---------------------------------------------------------------------------- advanced
# Point the stack at another repository instead of the demo copy (paths are relative to
# the docker/ directory). The repository needs a dags/ folder and, ideally, a healer.yaml.
# HEALER_REPO_DIR=../.demo/repo
# HEALER_LOGS_DIR=../.demo/logs
# HEALER_IMAGE=dag-healer/airflow:dev
