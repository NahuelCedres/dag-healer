<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="color-scheme" content="light">
<meta name="supported-color-schemes" content="light">
<title>{{ subject }}</title>
</head>
<body style="margin:0;padding:0;background:#f3f4f6;color:#111827;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;">
<div style="display:none;max-height:0;overflow:hidden;mso-hide:all;font-size:1px;line-height:1px;color:#f3f4f6;">{% block preheader %}{{ event_title }}: {{ incident.task_label }}{% endblock %}</div>
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="border-collapse:collapse;background:#f3f4f6;">
  <tr>
    <td align="center" style="padding:24px 12px;">
      <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="border-collapse:separate;max-width:680px;background:#ffffff;border:1px solid #e5e7eb;border-radius:8px;">
        <tr>
          <td style="padding:14px 24px;border-bottom:3px solid {{ accent }};">
            <span style="font-size:14px;font-weight:700;color:#111827;letter-spacing:0.02em;">dag-healer</span>
            <span style="float:right;font-size:12px;font-weight:700;color:{{ accent }};text-transform:uppercase;letter-spacing:0.05em;">{{ event_title }}</span>
          </td>
        </tr>
        <tr>
          <td style="padding:24px;">
            <h1 style="margin:0 0 8px 0;font-size:20px;line-height:26px;color:#111827;">{% block headline %}{{ event_title }}{% endblock %}</h1>
            <p style="margin:0 0 4px 0;font-size:13px;color:#6b7280;"><code style="font-family:SFMono-Regular,Consolas,'Liberation Mono',Menlo,monospace;">{{ incident.task_label }}</code></p>
            <p style="margin:12px 0 20px 0;font-size:14px;line-height:21px;color:#1f2937;">{% block lead %}{% endblock %}</p>
            {% block content %}{% endblock %}
          </td>
        </tr>
        <tr>
          <td style="padding:14px 24px;border-top:1px solid #e5e7eb;font-size:12px;line-height:18px;color:#6b7280;">
            Generated by dag-healer on {{ generated_at }} for incident <code style="font-family:SFMono-Regular,Consolas,'Liberation Mono',Menlo,monospace;">{{ incident.short_id or "-" }}</code>.
            Sample values and error text are masked before they leave the worker.
            <a href="{{ links.healer }}" style="color:#6b7280;text-decoration:underline;">Open the Healer page</a>.
          </td>
        </tr>
      </table>
    </td>
  </tr>
</table>
</body>
</html>
