{#- Plain-text building blocks of the alert emails (rendered with trim_blocks/lstrip_blocks).
    ``words`` holds the orchestrator's words and labels ("DAG", "Task", "Try" for Airflow). -#}
{% macro summary(incident, words) %}
{{ "%-15s " % (words.pipeline_label ~ ":") }}{{ incident.dag_id }}
{{ "%-15s " % (words.step_label ~ ":") }}{{ incident.task_id }}{{ " (%s %d)" % (words.map_index, incident.map_index) if incident.map_index >= 0 else "" }}
Run:            {{ incident.run_id }}
{{ "%-15s " % (words.attempt_label ~ ":") }}{{ incident.try_number }}
Classification: {{ incident.category_label }}{{ " (confidence " ~ incident.confidence_pct ~ ")" if incident.confidence_pct else "" }}
Status:         {{ incident.status }}
{% if incident.occurrences > 1 %}
Occurrences:    {{ incident.occurrences }} (deduplicated failures with the same signature)
{% endif %}
Incident:       {{ incident.id }}
{% endmacro %}

{% macro heading(title) -%}
{{ title }}
{{ "-" * (title | length) }}
{%- endmacro %}

{% macro violation_line(v) %}
- {{ v.rule }}{{ " [" ~ v.where ~ "]" if v.where else "" }}{{ ": " ~ v.message if v.message else "" }}
{% if v.expected or v.actual %}
  expected: {{ v.expected or "-" }} / actual: {{ v.actual or "-" }}{{ " (%d rows)" % v.rows if v.rows else "" }}
{% endif %}
{% endmacro %}

{% macro violations(items, more, title="Contract violations") %}
{% if items %}
{{ heading(title) }}
{% for v in items %}
{{ violation_line(v) }}
{%- endfor %}
{% if more %}
- ... and {{ more }} more
{% endif %}

{% endif %}
{% endmacro %}

{% macro sample_block(sample) %}
{% if sample %}
{{ heading("Masked data sample" ~ (" (" ~ sample.dataset ~ ")" if sample.dataset else "")) }}
{% if sample.omitted %}
{{ sample.omitted }}
{% else %}
{% for line in sample.text_lines %}
{{ line }}
{% endfor %}
{% if sample.hidden_rows or sample.hidden_columns %}
({{ sample.hidden_rows }} more rows and {{ sample.hidden_columns }} more columns not shown)
{% endif %}
Sensitive values are masked (h:... = salted hash, *** = redacted).
{% endif %}

{% endif %}
{% endmacro %}

{% macro text_block(title, text) %}
{% if text %}
{{ heading(title) }}
{{ text }}

{% endif %}
{% endmacro %}

{% macro list_block(title, items) %}
{% if items %}
{{ heading(title) }}
{% for item in items %}
- {{ item }}
{% endfor %}

{% endif %}
{% endmacro %}

{% macro link_line(label, url) -%}
{{ "%-17s" % (label ~ ":") }} {{ url }}
{%- endmacro %}

{% macro links_block(links, words, pr_label=None) %}
{{ heading("Links") }}
{{ link_line("Healer incident", links.task_instance) }}
{% if links.pr %}
{{ link_line(pr_label or ("Pull request" if links.pr_kind == "pull_request" else "PR.md"), links.pr) }}
{% endif %}
{{ link_line(words.pipeline_label ~ " incidents", links.dag) }}
{{ link_line("Healer page", links.healer) }}
{% for label, url in links.native.items() %}
{{ link_line("Open in " ~ label, url) }}
{% endfor %}
{% endmacro %}

{% macro footer(incident, generated_at) %}

--
Generated by dag-healer on {{ generated_at }} for incident {{ incident.short_id or "-" }}.
Sample values and error text are masked before they leave the worker.
{% endmacro %}
