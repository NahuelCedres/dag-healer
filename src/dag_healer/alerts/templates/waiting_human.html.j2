{% extends "_layout.html.j2" %}
{% import "_macros.html.j2" as m %}
{% block headline %}Human decision needed{% endblock %}
{% block lead %}dag-healer could not safely decide whether this failure is caused by the input data or by the code, so it is waiting for a human decision. Nothing has been changed.{% endblock %}
{% block content %}
{{ m.summary(incident, words) }}
{{ m.text_section("Why a human is needed", reason or "The automatic classification did not reach the required confidence.") }}
{{ m.text_section("Diagnosis", incident.diagnosis) }}
{{ m.pre_section("Error", incident.error_summary) }}
{{ m.violations(violations, violations_more, "Contract checks (evidence)") }}
{{ m.sample_table(sample) }}
{{ m.list_section("Evidence", incident.evidence) }}
{% call m.section("What you can do") %}
<ul style="margin:0 0 12px 0;padding:0 0 0 20px;font-size:14px;line-height:21px;color:#1f2937;">
  <li style="margin:0 0 4px 0;"><strong>Resolve as data</strong>: report it as a data issue and alert the data owners (no code change).</li>
  <li style="margin:0 0 4px 0;"><strong>Resolve as code</strong>: dag-healer writes a failing test and proposes a minimal fix.</li>
  <li style="margin:0 0 4px 0;"><strong>{{ words.retry_action }}</strong>: run the failed {{ words.step }} again once an external cause is fixed (the incident stays open).</li>
  <li style="margin:0 0 4px 0;"><strong>Ignore</strong>: close the incident without further action.</li>
</ul>
{{ m.button(links.task_instance, "Decide in the Healer incident tab", accent) }}
{{ m.secondary_links(links, words) }}
{% endcall %}
{% endblock %}
