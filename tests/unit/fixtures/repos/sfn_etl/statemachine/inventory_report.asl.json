{
  "Comment": "inventory_report: stock per SKU across the warehouses, flags SKUs below the low stock threshold (owner: ops). Input: {\"run_date\", \"warehouses\"}",
  "StartAt": "GetInventory",
  "States": {
    "GetInventory": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "${InventoryFunctionArn}",
        "Payload": {
          "step": "get_inventory",
          "execution.$": "$$.Execution.Id"
        }
      },
      "ResultPath": null,
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException",
            "Lambda.TooManyRequestsException"
          ],
          "IntervalSeconds": 1,
          "MaxAttempts": 3,
          "BackoffRate": 2
        }
      ],
      "Next": "PerWarehouse"
    },
    "PerWarehouse": {
      "Type": "Map",
      "ItemsPath": "$.warehouses",
      "ItemSelector": {
        "warehouse.$": "$$.Map.Item.Value",
        "execution.$": "$$.Execution.Id"
      },
      "MaxConcurrency": 1,
      "ItemProcessor": {
        "ProcessorConfig": {
          "Mode": "INLINE"
        },
        "StartAt": "BuildReport",
        "States": {
          "BuildReport": {
            "Type": "Task",
            "Resource": "${InventoryFunctionArn}",
            "Parameters": {
              "step": "build_report",
              "warehouse.$": "$.warehouse",
              "execution.$": "$.execution",
              "args": {
                "low_stock_threshold": 25
              }
            },
            "Retry": [
              {
                "ErrorEquals": [
                  "Lambda.ServiceException",
                  "Lambda.AWSLambdaException",
                  "Lambda.SdkClientException",
                  "Lambda.TooManyRequestsException"
                ],
                "IntervalSeconds": 1,
                "MaxAttempts": 3,
                "BackoffRate": 2
              }
            ],
            "End": true
          }
        }
      },
      "ResultPath": null,
      "Next": "PublishReport"
    },
    "PublishReport": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "${InventoryFunctionArn}",
        "Payload": {
          "step": "publish_report",
          "execution.$": "$$.Execution.Id"
        }
      },
      "ResultPath": null,
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException",
            "Lambda.TooManyRequestsException"
          ],
          "IntervalSeconds": 1,
          "MaxAttempts": 3,
          "BackoffRate": 2
        }
      ],
      "End": true
    }
  }
}
